# 로컬 기본값입니다. 운영에서는 Render persistent disk 경로인 /var/data를 사용합니다.
DATA_DIR=./data

# 운영 관리자 인증입니다. ADMIN_PASSWORD를 설정하면 관리자 화면과 관리 API가 보호됩니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# 설정하면 JSON 파일 대신 Supabase에 광고주 데이터를 저장합니다.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
